{
  "name": "TradeCrypto",
  "short_name": "TradeCrypto",
  "description": "Robinhood crypto desk \u2014 what it traded, what it skipped, and why.",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0B0F14",
