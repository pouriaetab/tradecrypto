# ─── TradeCrypto ──────────────────────────────────────────────────────────────
# Copy to .env and edit. Never commit .env.

# --- Ports (registered in control_deck) ---
BACKEND_PORT=8006
FRONTEND_PORT=5180
BACKEND_HOST=127.0.0.1
BACKEND_LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180

# --- Storage ---
TC_DB_PATH=./data/tradecrypto.sqlite

# --- EXECUTION MODE ---------------------------------------------------------
# paper    : simulated fills against real live quotes + measured cost model. SAFE.
# advisory : engine emits signed order tickets to a queue; a human (or a Claude
#            session holding the Robinhood MCP) executes them; fills recorded back.
# mcp      : engine places orders directly through the Robinhood agentic MCP.
# Anything other than `paper` requires TC_LIVE_CONFIRM below.
TC_EXECUTION_MODE=paper

# Typing this exact string is the ONLY way real money can be risked.
# Leave empty to make live trading structurally impossible.
TC_LIVE_CONFIRM=

# --- Robinhood agentic MCP (only used when TC_EXECUTION_MODE=mcp) ---
# Robinhood's agentic trading is an OAuth-gated remote MCP server, not a REST API.
TC_RH_MCP_URL=https://agent.robinhood.com/mcp/trading
TC_RH_TOKEN_PATH=./secrets/robinhood_mcp_token.json

# --- Market data (free, no API key required) ---
# Robinhood's own market data is only reachable through the agent MCP, which is
# rate-limited and LLM-mediated. We use a public exchange for quotes/history and
# continuously measure the BASIS between it and Robinhood's actual fills.
TC_PRIMARY_FEED=coinbase          # coinbase | kraken
TC_FALLBACK_FEED=kraken
TC_FEED_TIMEOUT_S=10
TC_POLL_INTERVAL_S=15

# --- RISK LIMITS (hard, enforced before every order) ---
# These had drifted months behind the running app. A new install got a $15 kill
# switch, a 3-position cap and a 12-trade day -- three limits that were removed
# on purpose -- so the app tripped its own safeties on day one and looked broken.
TC_ACCOUNT_EQUITY=500            # your declared stake, USD. Change this to yours.
TC_MAX_DAILY_LOSS_PCT=8.0        # kill switch: percent of stake lost in a day
TC_MAX_DAILY_LOSS_USD=0          # 0 = use the percent above, not a fixed dollar
TC_MAX_POSITION_FRAC=1.0         # per-symbol cap as a FRACTION of stake, so it
                                 # scales with the account instead of being a
                                 # dollar figure that silently stops scaling
TC_MAX_CONCURRENT_POSITIONS=0    # 0 = no slot cap. A slot cap rejects the best
                                 # signal of the day because three worse ones
                                 # arrived first.
TC_MAX_TRADES_PER_DAY=250        # a backstop against a runaway loop, not a budget
TC_PROBE_FRACTION=0.45           # size of a first probe relative to full size
TC_MAX_DRAWDOWN_PCT=10.0         # peak-to-trough on equity curve -> auto-halt to paper
TC_KELLY_FRACTION=0.25           # quarter-Kelly. Never raise above 0.5.

# --- Statistical gates (a strategy may not trade live until it passes) ---
TC_MIN_TRADES_FOR_LIVE=200       # minimum out-of-sample trades
TC_MIN_DEFLATED_SHARPE=0.0       # deflated Sharpe must exceed this
TC_MAX_PBO=0.35                  # probability of backtest overfitting ceiling
TC_COST_SAFETY_MULTIPLIER=1.5    # required gross edge = cost_hurdle * this

# --- Trade budget ---
# A budget ("take 2 trades today") is a CAP, never a quota to fill. Unused slots
# simply expire. This is the floor a trade must clear even at the deadline, in bps
# of expected edge ABOVE the cost hurdle. 0 = must at least cover its own costs.

# --- Phone access (both OFF by default; see START-HERE.md) ---
TC_LAN=0                         # 1 = reachable from other devices on this wifi
TC_TUNNEL=0                      # 1 = reachable from anywhere via a Cloudflare address
